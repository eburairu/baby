# Neon ブランチの接続文字列（Neonダッシュボードまたは mcp で取得）
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
TZ=Asia/Tokyo

# Test User Info (for development)
NEXT_PUBLIC_TEST_USER_USERNAME=testuser
NEXT_PUBLIC_TEST_USER_PASSWORD=password123
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=password123

# CORS (optional, defaults provided in code)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API Configuration (for frontend, optional defaults provided)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# AI育児日誌生成（LLM設定）
# LLM_PROVIDER: "openai"（デフォルト）または "google"（Google AI Studio）
LLM_PROVIDER=openai
# LLM_API_KEY: OpenAI の場合は "sk-..."、Google の場合は "AIza..."
LLM_API_KEY=
# LLM_MODEL: 未設定時は provider に応じて自動選択（gpt-4o-mini / gemini-2.0-flash）
# LLM_MODEL=gpt-4o-mini

