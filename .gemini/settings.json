{
  "experimental": {
    "enableAgents": true
  },
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_.*|replace|edit",
        "hooks": [
          {
            "name": "ai-worktree-guardrail",
            "type": "command",
            "command": "node scripts/ai_guardrail.js",
            "description": "AI エージェントがワークツリー外でファイルを編集することを阻止します"
          }
        ]
      }
    ]
  }
}